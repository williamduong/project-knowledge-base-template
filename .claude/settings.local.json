{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(rm -rf*)",
      "Bash(rm -r *)",
      "Bash(rmdir /s*)",
      "Bash(del /f*)",
      "Bash(del /s*)",
      "Bash(shutdown*)",
      "Bash(taskkill*)",
      "Bash(npm publish*)",
      "Bash(npm unpublish*)",
      "Bash(npm version *)"
    ]
  }
}
