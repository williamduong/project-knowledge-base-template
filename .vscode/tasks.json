{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start UI runtime (kbx ui start)",
      "type": "shell",
      "command": "node ./bin/kbx.js ui start",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Open UIV2 browser",
      "type": "shell",
      "command": "Start-Sleep -Seconds 5; Start-Process 'http://localhost:5173/intents'",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
