# kbx LLM configuration
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real API keys.

# ── Active provider ────────────────────────────────────────────────────────
# Options: anthropic | openai | azure | gemini | deepseek | openrouter | ollama
KBX_LLM_PROVIDER=anthropic

# ── Common settings ────────────────────────────────────────────────────────
KBX_LLM_MODEL=                  # leave blank to use provider default
KBX_LLM_MAX_TOKENS=4096
KBX_LLM_TIMEOUT_MS=30000

# ── Anthropic (Claude) ─────────────────────────────────────────────────────
# Default model: claude-sonnet-4-6
# Get key: https://console.anthropic.com/settings/keys
KBX_LLM_API_KEY=sk-ant-...

# ── OpenAI (GPT) ───────────────────────────────────────────────────────────
# Default model: gpt-4o
# Get key: https://platform.openai.com/api-keys
# KBX_LLM_PROVIDER=openai
# KBX_LLM_API_KEY=sk-...

# ── Azure OpenAI ───────────────────────────────────────────────────────────
# KBX_LLM_PROVIDER=azure
# KBX_LLM_ENDPOINT=https://<your-resource>.openai.azure.com
# KBX_LLM_API_KEY=<azure-api-key>
# KBX_LLM_MODEL=<deployment-name>        # Azure uses deployment name, not model name
# Additional Azure config (set via code or profile):
#   azureApiVersion: 2024-02-01

# ── Google Gemini ──────────────────────────────────────────────────────────
# Default model: gemini-2.0-flash
# Get key: https://aistudio.google.com/app/apikey
# KBX_LLM_PROVIDER=gemini
# KBX_LLM_API_KEY=AIza...

# ── DeepSeek ───────────────────────────────────────────────────────────────
# Default model: deepseek-chat (V3) — use deepseek-reasoner for R1
# Get key: https://platform.deepseek.com/api-keys
# KBX_LLM_PROVIDER=deepseek
# KBX_LLM_API_KEY=sk-...

# ── OpenRouter (routes to 100+ models) ────────────────────────────────────
# KBX_LLM_PROVIDER=openrouter
# KBX_LLM_API_KEY=sk-or-...
# KBX_LLM_MODEL=anthropic/claude-sonnet-4-6   # or openai/gpt-4o, google/gemini-flash...

# ── Ollama (local, air-gapped) ─────────────────────────────────────────────
# Default endpoint: http://localhost:11434
# Default model: llama3.2
# No API key needed.
# KBX_LLM_PROVIDER=ollama
# KBX_LLM_ENDPOINT=http://localhost:11434
# KBX_LLM_MODEL=llama3.2

# ── ArangoDB (Code Graph) ─────────────────────────────────────────────────
KBX_ARANGODB_URL=http://localhost:8529
KBX_ARANGODB_DB=kbx_code_graph
KBX_ARANGODB_USER=root
KBX_ARANGODB_PASS=
