# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Editor and local workspace settings
.vscode/
.idea/
.history/

# Temporary and backup files
*.tmp
*.temp
*.bak
*.swp
*~

# Local logs and scratch directories
logs/
tmp/
!dna/tmp/
!dna/tmp/README.md
temp/

# Node and npm artifacts
node_modules/
npm-debug.log*
_cacache/
_logs/
_update-notifier-last-checked

# Private notes (scratch); allowlist tracked subpaths below
notes/*
!notes/.gitkeep
!notes/npm-release-checklist.md
!notes/kbx-ui-kb-page-runtime-contract.md
!notes/kbx-ui-kb-page-svfactory-handoff.md

# Self-host KB runtime (Layer D) — committed but exclude cache/log noise
knowledge-base/.kb/_cacache/
knowledge-base/.kb/_logs/
knowledge-base/.kb/cache/
knowledge-base/.kb/logs/

# Self-host generated agent files — track when produced by `kb init` on this repo
# (No ignore needed; previously ignored entries removed for self-host profile)

# Sample repos and test sandboxes (Layer E)
sample_repo/
kb-test-sample/

# Per-developer editor settings
# (.vscode/ already ignored above)

# Generic build outputs
out/

# UIV2 local build artifacts
site/uiv2/dist/
site/uiv2/node_modules/
site/uiv2/*.tsbuildinfo
site/uiv2/vite.config.js
site/uiv2/vite.config.d.ts

# Local bridge runtime state
site/kbx-ui/.runtime-services-state.json
site/kbx-ui/.runtime-state/

# SVFactory runtime state DB (generated by focus-state bridge)
svfactory/*.db
svfactory/*.db-shm
svfactory/*.db-wal

# Temp process watch scripts
.tmp-*

# kb orchestrator reports (legacy root outputs)
kb-orch-report-*.json
project-knowledge-base-template.code-workspace

# Local env — never commit real keys
.env
.env.local
